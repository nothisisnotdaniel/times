<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <!-- [LibraryImport] for the OS credential stores (TokenStore.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tm</ToolCommandName>
    <PackageId>Times</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
    <Description>Times: an interactive terminal app for tracking check-ins, check-outs, breaks and checkpoints on projects.</Description>
    <Authors>Daniel Legien</Authors>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <!-- The public key update packages are verified with. Only the user commits it; without it the
       build still works and Times stages no update (UpdateSignature has no key). -->
  <ItemGroup Condition="Exists('update-key.pem')">
    <EmbeddedResource Include="update-key.pem" LogicalName="Times.update-key.pem" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Times.Tests" />
  </ItemGroup>

  <!-- Release builds pass -p:Version from the git tag (vX.Y.Z without the v); refuse anything that is not SemVer. -->
  <Target Name="ValidateVersion" BeforeTargets="BeforeBuild">
    <Error
      Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'))"
      Text="Version '$(Version)' is not a valid SemVer version (expected MAJOR.MINOR.PATCH or MAJOR.MINOR.PATCH-prerelease, for example 1.2.3 or 1.2.3-beta.1, without a leading 'v' or '+build' metadata)." />
  </Target>

</Project>
