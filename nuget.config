<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain guard: the package ID "Times" may only come from the local ./nupkg folder
  (relative to this file), never from nuget.org. <clear /> drops user- and machine-level
  feeds so no unmapped source is merged in.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="./nupkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Times" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
