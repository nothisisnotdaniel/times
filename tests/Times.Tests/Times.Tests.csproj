<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <FixtureNativeDir>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/native</FixtureNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The old tool's sample day files are the import fixtures; they live once, in import-samples/. -->
    <None Include="..\..\import-samples\*.json" LinkBase="import-samples" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="MacKeychainFixtureReader.c" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Times\Times.csproj" />
    <ProjectReference Include="..\..\src\Times.Tray.Core\Times.Tray.Core.csproj" />
    <ProjectReference Include="..\..\tools\Times.LicenceIssuer\Times.LicenceIssuer.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(FixtureNativeDir)/libTimesKeychainFixture.dylib"
          Link="libTimesKeychainFixture.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The selected-Keychain creation case issues under a dedicated executable identity. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <GenerateProgramFile>false</GenerateProgramFile>
    <DefineConstants>$(DefineConstants);KEYCHAIN_FIXTURE_APPHOST</DefineConstants>
  </PropertyGroup>

  <Target Name="BuildKeychainFixture" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="MacKeychainFixture.c;$(MSBuildProjectFile)" Outputs="$(FixtureNativeDir)/libTimesKeychainFixture.dylib">
    <MakeDir Directories="$(FixtureNativeDir)" />
    <Exec Command="xcrun clang -std=c11 -Wall -Werror -Wno-deprecated-declarations -dynamiclib -framework Security -framework CoreFoundation &quot;$(MSBuildProjectDirectory)/MacKeychainFixture.c&quot; -o &quot;$(FixtureNativeDir)/libTimesKeychainFixture.dylib&quot;" />
  </Target>

</Project>
