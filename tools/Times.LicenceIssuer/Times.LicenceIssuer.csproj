<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer-only: issues Suite Pro licence keys by hand. Holds the only signing code; never packed or shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Times.LicenceIssuer</RootNamespace>
    <IssuerNativeDir>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/native</IssuerNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Times\Times.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Times.Tests" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(IssuerNativeDir)/libTimesIssuerKeychain.dylib"
          Link="libTimesIssuerKeychain.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(IssuerNativeDir)/TimesKeychainView"
          Link="TimesKeychainView" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildIssuerKeychain" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="KeychainMigration.c;KeychainPolicy.c;KeychainFiles.c;KeychainView.c;VerifierIdentity.c;build-keychain.sh;$(MSBuildProjectFile)"
          Outputs="$(IssuerNativeDir)/libTimesIssuerKeychain.dylib;$(IssuerNativeDir)/TimesKeychainView">
    <MakeDir Directories="$(IssuerNativeDir)" />
    <Exec Command="/bin/sh build-keychain.sh &quot;$(IssuerNativeDir)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
